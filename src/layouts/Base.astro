---
import { APP_STORE_ID, SITE_URL } from '../config';

interface Props {
  title: string;
  description: string;
  loader?: boolean;
  /** Share image path (from /og/...). Defaults to the home image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** JSON-LD objects for this page. */
  jsonld?: object[];
  /** Hide from search engines (404, empty topic pages). */
  noindex?: boolean;
  /** Browser bar colour in light mode. The home page is dark at the top in both modes. */
  themeLight?: string;
  rss?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}
const {
  title, description, loader = false, image = '/og/home.png', imageAlt = 'Day+, a habit tracker for iPhone',
  type = 'website', jsonld = [], noindex = false, themeLight = '#E3EFF0', rss = false, publishedTime, modifiedTime,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const img = new URL(image, SITE_URL).href;
// JSON-LD is data, not code: escape "<" so it can never close the script tag.
const ld = jsonld.map((o) => JSON.stringify(o).replace(/</g, '\\u003c'));
---
<!doctype html>
<html lang="en-US" data-loader={loader ? '' : undefined}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta name="color-scheme" content="dark light" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content={themeLight} />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#07090A" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
{rss && <link rel="alternate" type="application/rss+xml" title="Day+ Blog" href="/blog/rss.xml" />}
{APP_STORE_ID && <meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />}
<meta property="og:site_name" content="Day+" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={img} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={img} />
<meta name="twitter:image:alt" content={imageAlt} />
<script is:inline src="/js/boot.js"></script>
{ld.map((j) => <script type="application/ld+json" set:html={j} />)}
<slot name="head" />
</head>
<body>
<slot />
</body>
</html>
