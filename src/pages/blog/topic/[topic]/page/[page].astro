---
import type { GetStaticPaths } from 'astro';
import BlogIndex from '../../../../../components/BlogIndex.astro';
import { getPosts, PER_PAGE } from '../../../../../lib/posts';
import { TOPIC_NAMES, topicSlug } from '../../../../../lib/topics';

export const getStaticPaths = (async () => {
  const all = await getPosts();
  return TOPIC_NAMES.flatMap((t) => {
    const posts = all.filter((p) => p.data.topic === t);
    const pages = Math.ceil(Math.max(0, posts.length - 1) / PER_PAGE);
    return Array.from({ length: Math.max(0, pages - 1) }, (_, i) => ({
      params: { topic: topicSlug(t), page: String(i + 2) },
      props: { topic: t, posts },
    }));
  });
}) satisfies GetStaticPaths;

const { topic, posts } = Astro.props;
---
<BlogIndex posts={posts} page={Number(Astro.params.page)} topic={topic} />
